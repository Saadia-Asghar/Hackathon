{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "0.1.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "developer": {
    "name": "SignBridge Team",
    "websiteUrl": "https://YOUR-APP.azurestaticapps.net",
    "privacyUrl": "https://YOUR-APP.azurestaticapps.net/about",
    "termsOfUseUrl": "https://YOUR-APP.azurestaticapps.net/about"
  },
  "name": { "short": "SignBridge", "full": "SignBridge sign-language translator" },
  "description": {
    "short": "Live sign-language to captions in meetings.",
    "full": "SignBridge recognises sign language from the camera and shows captions and voice, so deaf and hearing colleagues can talk in Teams meetings and chats."
  },
  "icons": { "color": "color.png", "outline": "outline.png" },
  "accentColor": "#0B1220",
  "staticTabs": [
    { "entityId": "conversation", "name": "Conversation", "contentUrl": "https://YOUR-APP.azurestaticapps.net/conversation", "scopes": ["personal"] },
    { "entityId": "learn", "name": "Learn signs", "contentUrl": "https://YOUR-APP.azurestaticapps.net/learn", "scopes": ["personal"] }
  ],
  "configurableTabs": [
    { "configurationUrl": "https://YOUR-APP.azurestaticapps.net/conversation", "canUpdateConfiguration": false, "scopes": ["team", "groupChat"], "context": ["meetingSidePanel", "channelTab", "privateChatTab"] }
  ],
  "permissions": ["identity"],
  "devicePermissions": ["media"],
  "validDomains": ["YOUR-APP.azurestaticapps.net"]
}
